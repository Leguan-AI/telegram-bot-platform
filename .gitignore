# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local dev environment
.qodo/
.vscode/
.idea/

# Supabase CLI local state
supabase/.temp/

# probe transcripts (scripts/probe-custom-tool-support.ts PROBE_DUMP output)
probe-dump*.json
*-probe-dump.json

# Local dev-server config for the Claude Code browser preview (per-machine)
.claude/launch.json
